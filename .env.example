# Application
NODE_ENV=development
PORT=3000

# HTTP
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BODY_JSON_LIMIT=1mb
BODY_URLENCODED_LIMIT=1mb

# Database
POSTGRES_USER=mdc
POSTGRES_PASSWORD=mdc_dev_password
POSTGRES_DB=mdc
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mdc:mdc_dev_password@localhost:5432/mdc?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Health checks
HEALTH_DATABASE_TIMEOUT_MS=1000
HEALTH_REDIS_TIMEOUT_MS=1000

# S3 / MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=mdc-media
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
HEALTH_S3_TIMEOUT_MS=3000

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_PORT=9200
HEALTH_ELASTICSEARCH_TIMEOUT_MS=5000

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mdc.local
HEALTH_MAILER_TIMEOUT_MS=3000

# OpenTelemetry
OTEL_SERVICE_NAME=mdc-be
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Phase 1+ Authentication ---
# JWT Authentication
JWT_ACCESS_SECRET=your-access-secret-here-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-here-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Configuration
COOKIE_SECRET=your-cookie-secret-here-min-32-chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate Limiting (optional - defaults shown)
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL=60000
THROTTLE_REGISTER_LIMIT=3
THROTTLE_REGISTER_TTL=60000
THROTTLE_PASSWORD_RESET_LIMIT=3
THROTTLE_PASSWORD_RESET_TTL=300000
THROTTLE_RESEND_VERIFICATION_LIMIT=1
THROTTLE_RESEND_VERIFICATION_TTL=60000
THROTTLE_REFRESH_LIMIT=10
THROTTLE_REFRESH_TTL=60000

# API
APP_PROCESS_ROLE=all
API_PREFIX=/api/v1
LOG_LEVEL=info

# Media upload
MEDIA_AVATAR_MAX_SIZE_BYTES=5242880
MEDIA_RESUME_MAX_SIZE_BYTES=20971520
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
