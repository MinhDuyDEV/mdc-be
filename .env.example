# Application
NODE_ENV=development
APP_PROCESS_ROLE=all
PORT=3000
API_PREFIX=/api/v1

# HTTP
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BODY_JSON_LIMIT=1mb
BODY_URLENCODED_LIMIT=1mb

# Database
POSTGRES_USER=mdc
POSTGRES_PASSWORD=mdc_dev_password
POSTGRES_DB=mdc
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mdc:mdc_dev_password@localhost:5432/mdc?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Health checks
HEALTH_DATABASE_TIMEOUT_MS=1000
HEALTH_REDIS_TIMEOUT_MS=1000

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Logging
LOG_LEVEL=info
