# Application
NODE_ENV=development
PORT=3000

# HTTP
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BODY_JSON_LIMIT=1mb
BODY_URLENCODED_LIMIT=1mb

# Database
POSTGRES_USER=mdc
POSTGRES_PASSWORD=mdc_dev_password
POSTGRES_DB=mdc
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mdc:mdc_dev_password@localhost:5432/mdc?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Health checks
HEALTH_DATABASE_TIMEOUT_MS=1000
HEALTH_REDIS_TIMEOUT_MS=1000

# S3 / MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=mdc-media
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
HEALTH_S3_TIMEOUT_MS=3000

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_PORT=9200
HEALTH_ELASTICSEARCH_TIMEOUT_MS=5000

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mdc.local
HEALTH_MAILER_TIMEOUT_MS=3000

# OpenTelemetry
OTEL_SERVICE_NAME=mdc-be
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Phase 1+ (not yet wired) ---
# JWT_SECRET=<generate-a-64-char-random-secret>
# JWT_ACCESS_TOKEN_TTL=15m
# JWT_REFRESH_TOKEN_TTL=7d
# APP_PROCESS_ROLE=all
# API_PREFIX=/api/v1
# LOG_LEVEL=info
