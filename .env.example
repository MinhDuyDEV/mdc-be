# Application
NODE_ENV=development
PORT=3000

# HTTP
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BODY_JSON_LIMIT=1mb
BODY_URLENCODED_LIMIT=1mb

# Database
# Add role-specific connection_limit in deployment DATABASE_URL values:
# api/all: connection_limit=10, worker: connection_limit=5, realtime: connection_limit=3.
# Example: postgresql://.../mdc?schema=public&connection_limit=10&pool_timeout=10
POSTGRES_USER=mdc
POSTGRES_PASSWORD=mdc_dev_password
POSTGRES_DB=mdc
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mdc:mdc_dev_password@localhost:5432/mdc?schema=public
PRISMA_TRANSACTION_MAX_WAIT_MS=5000
PRISMA_TRANSACTION_TIMEOUT_MS=15000

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Health checks
HEALTH_DATABASE_TIMEOUT_MS=1000
HEALTH_REDIS_TIMEOUT_MS=1000

# S3 / MinIO Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=mdc-media
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
HEALTH_S3_TIMEOUT_MS=3000

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_PORT=9200
HEALTH_ELASTICSEARCH_TIMEOUT_MS=5000

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mdc.local
HEALTH_MAILER_TIMEOUT_MS=3000

# OpenTelemetry
OTEL_SERVICE_NAME=mdc-be
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Phase 1+ Authentication ---
# JWT Authentication
JWT_ACCESS_SECRET=your-access-secret-here-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Configuration
COOKIE_SECRET=your-cookie-secret-here-min-32-chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate Limiting (optional - defaults shown)
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL=60000
THROTTLE_REGISTER_LIMIT=3
THROTTLE_REGISTER_TTL=60000
THROTTLE_PASSWORD_RESET_LIMIT=3
THROTTLE_PASSWORD_RESET_TTL=300000
THROTTLE_RESEND_VERIFICATION_LIMIT=1
THROTTLE_RESEND_VERIFICATION_TTL=60000
THROTTLE_REFRESH_LIMIT=10
THROTTLE_REFRESH_TTL=60000

# API
APP_PROCESS_ROLE=all
API_PREFIX=/api/v1
LOG_LEVEL=info

# Media upload
MEDIA_AVATAR_MAX_SIZE_BYTES=5242880
MEDIA_RESUME_MAX_SIZE_BYTES=20971520
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

# Billing
BILLING_PROVIDER=mock
BILLING_WEBHOOK_SECRET=whsec_test_secret
BILLING_DEFAULT_FREE_PLAN_SLUG=free

# Push Notifications — FCM (Firebase Cloud Messaging, Android)
# Set FCM_ENABLED=true and provide service account JSON to enable Android push
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT_PATH=

# Push Notifications — APNs (Apple Push Notification service, iOS)
# Set APNS_ENABLED=true and provide signing key to enable iOS push
APNS_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_SIGNING_KEY_PATH=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false

# Feature Flags — Unleash (OSS)
# Set UNLEASH_ENABLED=false to disable (default-on for dev); set to true with URL/token for prod
UNLEASH_ENABLED=false
UNLEASH_URL=http://localhost:4242/api
UNLEASH_API_TOKEN=
UNLEASH_APP_NAME=mdc-be

# Email Tracking (CNIL compliance)
# EMAIL_TRACKING_BASE_URL is the public URL used in tracking pixels and click redirects
# EMAIL_UNSUBSCRIBE_SECRET is used to sign unsubscribe tokens (v2); v1 uses base64url JSON
EMAIL_TRACKING_BASE_URL=http://localhost:3000
EMAIL_UNSUBSCRIBE_SECRET=change-me-in-production
