{
	"name": "mdc-be",
	"version": "0.0.1",
	"description": "NestJS backend for a professional networking and jobs platform.",
	"author": "MinhDuyDEV",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "node --require ./src/instrumentation.ts --require ts-node/register --require tsconfig-paths/register node_modules/@nestjs/cli/bin/nest.js start --watch",
		"start:dev:otel": "node --require ./src/instrumentation.ts --require ts-node/register --require tsconfig-paths/register node_modules/@nestjs/cli/bin/nest.js start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node --require ./dist/instrumentation.js dist/main.js",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
		"lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"check": "npm run typecheck && npm run lint && npm test",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"typecheck": "tsc --noEmit",
		"prisma:validate": "prisma validate",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:migrate:deploy": "prisma migrate deploy",
		"db:reset": "prisma migrate reset"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1053.0",
		"@aws-sdk/s3-request-presigner": "^3.1048.0",
		"@elastic/elasticsearch": "~8.17",
		"@nest-lab/throttler-storage-redis": "^1.2.0",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.23",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/mapped-types": "^2.1.1",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/platform-socket.io": "^11.1.23",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/throttler": "^6.5.0",
		"@nestjs/websockets": "^11.1.22",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.76.0",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
		"@opentelemetry/sdk-node": "^0.218.0",
		"@opentelemetry/semantic-conventions": "^1.41.1",
		"@prisma/client": "^6.19.3",
		"@prisma/instrumentation": "^6.19.3",
		"@socket.io/redis-adapter": "^8.3.0",
		"bcryptjs": "^3.0.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"cookie-parser": "^1.4.7",
		"handlebars": "^4.7.9",
		"helmet": "^8.1.0",
		"ioredis": "^5.10.1",
		"nestjs-pino": "^4.6.1",
		"nodemailer": "^8.0.7",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"socket.io": "^4.8.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.18.0",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@testcontainers/postgresql": "^12.0.0",
		"@types/bcryptjs": "^3.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.0",
		"@types/handlebars": "^4.0.40",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.10.7",
		"@types/nodemailer": "^6.4.23",
		"@types/passport-jwt": "^4.0.1",
		"@types/supertest": "^6.0.2",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.2",
		"globals": "^16.0.0",
		"jest": "^30.0.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.4.2",
		"prisma": "^6.19.3",
		"socket.io-client": "^4.8.3",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"testcontainers": "^12.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.20.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"setupFiles": [
			"<rootDir>/../jest.setup.ts"
		],
		"collectCoverageFrom": [
			"**/*.ts",
			"!**/*.spec.ts",
			"!**/*.module.ts",
			"!**/*.dto.ts",
			"!**/dto/**",
			"!**/index.ts",
			"!**/*.constants.ts",
			"!**/*.types.ts",
			"!main.ts",
			"!instrumentation.ts"
		],
		"coveragePathIgnorePatterns": [
			"/node_modules/",
			"/dto/",
			"\\.module\\.ts$",
			"\\.dto\\.ts$",
			"index\\.ts$",
			"\\.constants\\.ts$",
			"\\.types\\.ts$",
			"main\\.ts$",
			"instrumentation\\.ts$"
		],
		"coverageDirectory": "../coverage",
		"coverageThreshold": {
			"global": {
				"branches": 50,
				"functions": 57,
				"lines": 59,
				"statements": 60
			}
		},
		"testEnvironment": "node"
	}
}
