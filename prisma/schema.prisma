  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

// Posts domain
model Post {
  id            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId      String                     @map("author_id") @db.Uuid
  content       String                     @db.Text
  visibility    PostVisibility             @default(PUBLIC)
  status        PostStatus                 @default(PUBLISHED)
  commentCount  Int                        @default(0) @map("comment_count")
  reactionCount Int                        @default(0) @map("reaction_count")
  searchVector  Unsupported("tsvector")?   @default(dbgenerated("''::tsvector")) @map("search_vector")
  deletedAt     DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  author    User         @relation("PostsAsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions Reaction[]
  hashtags  PostHashtag[]
  media     PostMedia[]
  savedBy   SavedPost[]
  hiddenBy  HiddenPost[]
  mentions  Mention[]

  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)], name: "idx_posts_author_timeline")
  @@index([createdAt(sort: Desc), id(sort: Desc)], name: "idx_posts_feed")
  @@index([visibility, status, deletedAt])
  @@index([searchVector], type: Gin, name: "idx_posts_search")
  @@map("posts")
}

model Comment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  content   String    @db.Text
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User      @relation("CommentsAsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")
  mentions Mention[]

  @@index([postId, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

model Reaction {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String       @map("post_id") @db.Uuid
  authorId  String       @map("author_id") @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
