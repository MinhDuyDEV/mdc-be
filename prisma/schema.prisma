generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum MediaStatus {
  PENDING
  READY
  QUARANTINED
  DELETED
}

enum ProfileVisibility {
  PUBLIC
  CONNECTIONS_ONLY
  PRIVATE
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  TOOL
  SOFT
  OTHER
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LanguageProficiency {
  ELEMENTARY
  LIMITED_WORKING
  PROFESSIONAL_WORKING
  FULL_PROFESSIONAL
  NATIVE_BILINGUAL
}

enum Industry {
  TECHNOLOGY
  FINANCE
  HEALTHCARE
  EDUCATION
  RETAIL
  MANUFACTURING
  CONSULTING
  REAL_ESTATE
  HOSPITALITY
  TRANSPORTATION
  ENERGY
  TELECOMMUNICATIONS
  MEDIA
  LEGAL
  NONPROFIT
  GOVERNMENT
  AGRICULTURE
  CONSTRUCTION
  AUTOMOTIVE
  OTHER
}

enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
}

enum ApplyMode {
  INTERNAL
  EXTERNAL
  HYBRID
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  DELETED
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWED
  INTERVIEWING
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  REMOVED
}

enum FollowStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  // Applications domain
  ApplicationSubmitted
  ApplicationStatusChanged
  ApplicationNoteAdded
  ApplicationWithdrawn
  // Jobs domain
  JobPublished
  JobUpdated
  JobClosed
  // Recruiting domain
  CandidateSaved
  CandidateAddedToTalentPool
  RecruiterSeatAllocated
  // Connections domain
  ConnectionRequested
  ConnectionAccepted
  UserBlocked
  // System / generic
  System
  // Posts domain
  PostLiked
  PostCommented
  MentionedInPost
  MentionedInComment
  // Messaging domain
  NewMessage
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ParticipantRole {
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  SYSTEM
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum PostVisibility {
  PUBLIC
  CONNECTIONS
  PRIVATE
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  LOVE
  INSIGHTFUL
  CURIOUS
}

model User {
  id                          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                       String                   @unique
  passwordHash                String?                  @map("password_hash")
  emailVerifiedAt             DateTime?                @map("email_verified_at")
  displayName                 String?                  @map("display_name")
  status                      UserStatus               @default(ACTIVE)
  createdAt                   DateTime                 @default(now()) @map("created_at")
  updatedAt                   DateTime                 @updatedAt @map("updated_at")
  refreshTokens               RefreshToken[]
  auditLogs                   AuditLog[]
  verificationTokens          VerificationToken[]
  preference                  UserPreference?
  profile                     Profile?
  mediaAssets                 MediaAsset[]
  endorsements                Endorsement[]
  companyMembers              CompanyMember[]
  companyFollowers            CompanyFollower[]
  verificationsRequested      CompanyVerification[]    @relation("VerificationRequester")
  verificationsReviewed       CompanyVerification[]    @relation("VerificationReviewer")
  recruiterSeats              RecruiterSeat[]
  memberInvitations           MemberInvitation[]
  jobsCreated                 Job[]                    @relation("JobsCreated")
  savedJobs                   SavedJob[]
  jobViews                    JobView[]
  applications                Application[]
  applicationStatusEvents     ApplicationStatusEvent[] @relation("ApplicationStatusEvents")
  applicationNotes            ApplicationNote[]        @relation("ApplicationNotes")
  savedCandidatesAsCandidate  SavedCandidate[]         @relation("SavedCandidatesAsCandidate")
  savedCandidatesBySaver      SavedCandidate[]         @relation("SavedCandidatesBySaver")
  talentPoolsCreated          TalentPool[]             @relation("TalentPoolsCreated")
  talentPoolCandidates        TalentPoolCandidate[]    @relation("TalentPoolCandidates")
  talentPoolCandidatesAddedBy TalentPoolCandidate[]    @relation("TalentPoolCandidatesAddedBy")
  candidateNotesAsCandidate   CandidateNote[]          @relation("CandidateNotesAsCandidate")
  candidateNotesByAuthor      CandidateNote[]          @relation("CandidateNotesByAuthor")
  notifications               Notification[]
  connectionsAsRequester      Connection[]             @relation("ConnectionsAsRequester")
  connectionsAsAddressee      Connection[]             @relation("ConnectionsAsAddressee")
  followsAsFollower           Follow[]                @relation("FollowsAsFollower")
  followsAsFollowee           Follow[]                @relation("FollowsAsFollowee")
  blocksAsBlocker   Block[]    @relation("BlocksAsBlocker")
  blocksAsBlocked   Block[]    @relation("BlocksAsBlocked")
  posts              Post[]    @relation("PostsAsAuthor")
  comments           Comment[] @relation("CommentsAsAuthor")
  reactions          Reaction[] @relation("ReactionsAsAuthor")
  savedPosts         SavedPost[]
  hiddenPosts        HiddenPost[]
  mentionsReceived   Mention[] @relation("MentionsAsMentioned")
  mentionsGiven      Mention[] @relation("MentionsAsMentioner")
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]                 @relation("MessagesSent")
  messageReadStates        MessageReadState[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String            @map("event_type")
  aggregateType String?           @map("aggregate_type")
  aggregateId   String?           @map("aggregate_id")
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now()) @map("available_at")
  lockedAt      DateTime?         @map("locked_at")
  lockedBy      String?           @map("locked_by")
  processedAt   DateTime?         @map("processed_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deadLetter    OutboxDeadLetter?

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType])
  @@map("outbox_events")
}

model OutboxDeadLetter {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outboxEventId String?      @unique @map("outbox_event_id") @db.Uuid
  eventType     String       @map("event_type")
  payload       Json
  reason        String
  failedAt      DateTime     @default(now()) @map("failed_at")
  outboxEvent   OutboxEvent? @relation(fields: [outboxEventId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([failedAt])
  @@map("outbox_dead_letters")
}

model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model VerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model UserPreference {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  theme     String?  @default("system")
  language  String?  @default("en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model EmailDelivery {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  to           String
  subject      String
  template     String
  context      Json
  status       EmailStatus @default(PENDING)
  sentAt       DateTime?   @map("sent_at")
  failedAt     DateTime?   @map("failed_at")
  errorMessage String?     @map("error_message")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("email_deliveries")
}

model Profile {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String                   @unique @map("user_id") @db.Uuid
  headline           String?                  @db.VarChar(200)
  about              String?                  @db.Text
  location           String?                  @db.VarChar(200)
  website            String?                  @db.VarChar(500)
  openToWork         Boolean                  @default(false) @map("open_to_work")
  recruitingEligible Boolean                  @default(false) @map("recruiting_eligible")
  visibility         ProfileVisibility        @default(PUBLIC)
  searchVector       Unsupported("tsvector")? @default(dbgenerated("''::tsvector")) @map("search_vector")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills         ProfileSkill[]
  experiences    Experience[]
  educations     Education[]
  certifications Certification[]
  languages      ProfileLanguage[]
  endorsements   Endorsement[]

  @@index([searchVector], type: Gin, name: "idx_profiles_search")
  @@map("profiles")
}

model Company {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String                   @db.VarChar(200)
  slug              String                   @db.VarChar(200)
  industry          Industry?
  description       String?                  @db.Text
  website           String?                  @db.VarChar(500)
  logoMediaAssetId  String?                  @map("logo_media_asset_id") @db.Uuid
  coverMediaAssetId String?                  @map("cover_media_asset_id") @db.Uuid
  verified          Boolean                  @default(false)
  verifiedAt        DateTime?                @map("verified_at") @db.Timestamptz(3)
  followerCount     Int                      @default(0) @map("follower_count")
  employeeCount     String?                  @map("employee_count") @db.VarChar(50)
  foundedYear       Int?                     @map("founded_year")
  headquarters      String?                  @db.VarChar(200)
  searchVector      Unsupported("tsvector")? @default(dbgenerated("''::tsvector")) @map("search_vector")
  deletedAt         DateTime?                @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  logoMediaAsset    MediaAsset?           @relation("CompanyLogo", fields: [logoMediaAssetId], references: [id], onDelete: SetNull)
  coverMediaAsset   MediaAsset?           @relation("CompanyCover", fields: [coverMediaAssetId], references: [id], onDelete: SetNull)
  members           CompanyMember[]
  followers         CompanyFollower[]
  verifications     CompanyVerification[]
  entitlements      CompanyEntitlement[]
  recruiterSeats    RecruiterSeat[]
  memberInvitations MemberInvitation[]
  jobs              Job[]
  savedCandidates   SavedCandidate[]
  talentPools       TalentPool[]
  candidateNotes    CandidateNote[]

  @@index([slug])
  @@index([industry])
  @@index([verified])
  @@index([deletedAt])
  @@index([searchVector], type: Gin, name: "idx_companies_search")
  @@map("companies")
}

model ProfileSkill {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String            @map("profile_id") @db.Uuid
  name        String            @db.VarChar(100)
  category    SkillCategory?
  proficiency SkillProficiency?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  endorsements Endorsement[]

  @@unique([profileId, name])
  @@map("profile_skills")
}

model Experience {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  title       String    @db.VarChar(200)
  company     String    @db.VarChar(200)
  companyUrl  String?   @map("company_url") @db.VarChar(500)
  location    String?   @db.VarChar(200)
  description String?   @db.Text
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isCurrent   Boolean   @default(false) @map("is_current")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("experiences")
}

model Education {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId    String    @map("profile_id") @db.Uuid
  school       String    @db.VarChar(200)
  degree       String    @db.VarChar(200)
  fieldOfStudy String?   @map("field_of_study") @db.VarChar(200)
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  grade        String?   @db.VarChar(50)
  activities   String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("educations")
}

model Certification {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId           String    @map("profile_id") @db.Uuid
  name                String    @db.VarChar(200)
  issuingOrganization String    @map("issuing_organization") @db.VarChar(200)
  issueDate           DateTime  @map("issue_date") @db.Date
  expirationDate      DateTime? @map("expiration_date") @db.Date
  credentialId        String?   @map("credential_id") @db.VarChar(200)
  credentialUrl       String?   @map("credential_url") @db.VarChar(500)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("certifications")
}

model ProfileLanguage {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String              @map("profile_id") @db.Uuid
  language    String              @db.VarChar(100)
  proficiency LanguageProficiency
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, language])
  @@map("profile_languages")
}

model Endorsement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId      String   @map("profile_id") @db.Uuid
  profileSkillId String   @map("profile_skill_id") @db.Uuid
  endorserId     String   @map("endorser_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileSkill ProfileSkill @relation(fields: [profileSkillId], references: [id], onDelete: Cascade)
  endorser     User         @relation(fields: [endorserId], references: [id], onDelete: Cascade)

  @@unique([profileSkillId, endorserId])
  @@index([profileId])
  @@map("endorsements")
}

model MediaAsset {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String      @map("owner_id") @db.Uuid
  purpose     String      @db.VarChar(50)
  filename    String      @db.VarChar(500)
  s3Key       String      @unique @map("s3_key") @db.VarChar(500)
  s3Bucket    String      @map("s3_bucket") @db.VarChar(200)
  contentType String      @map("content_type") @db.VarChar(200)
  sizeBytes   Int?        @map("size_bytes")
  status      MediaStatus @default(PENDING)
  etag        String?     @db.VarChar(200)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner                  User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  companyLogos           Company[]               @relation("CompanyLogo")
  companyCovers          Company[]               @relation("CompanyCover")
  applicationResumes     Application[]           @relation("ApplicationResume")
  applicationAttachments ApplicationAttachment[] @relation("ApplicationAttachments")
  postMedia              PostMedia[]
  messageAttachments     MessageAttachment[]

  @@index([ownerId, status])
  @@map("media_assets")
}

model CompanyMember {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      CompanyRole
  title     String?     @db.VarChar(200)
  status    String      @default("active") @db.VarChar(50)
  joinedAt  DateTime    @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@map("company_members")
}

model CompanyFollower {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@map("company_followers")
}

model CompanyVerification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  status            String    @default("pending") @db.VarChar(50)
  documentUrls      String[]  @map("document_urls")
  notes             String?   @db.Text
  reviewedByUserId  String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("VerificationRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedBy  User?   @relation("VerificationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@map("company_verifications")
}

model CompanyEntitlement {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  entitlementType  String   @map("entitlement_type") @db.VarChar(100)
  creditsTotal     Int      @map("credits_total")
  creditsUsed      Int      @default(0) @map("credits_used")
  creditsRemaining Int      @map("credits_remaining")
  validFrom        DateTime @map("valid_from") @db.Timestamptz(3)
  validUntil       DateTime @map("valid_until") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([entitlementType])
  @@index([validUntil])
  @@map("company_entitlements")
}

model RecruiterSeat {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  status      String    @default("available") @db.VarChar(50)
  allocatedAt DateTime? @map("allocated_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@map("recruiter_seats")
}

model MemberInvitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  email      String    @db.VarChar(255)
  role       String    @db.VarChar(50)
  token      String    @unique @db.VarChar(255)
  invitedBy  String    @map("invited_by") @db.Uuid
  status     String    @default("pending") @db.VarChar(50)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inviter User    @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
  @@map("member_invitations")
}

model Job {
  id              String                   @id @default(uuid()) @db.Uuid
  companyId       String                   @map("company_id") @db.Uuid
  title           String                   @db.VarChar(255)
  description     String                   @db.Text
  applyMode       ApplyMode                @map("apply_mode")
  applyUrl        String?                  @map("apply_url") @db.VarChar(2048)
  status          JobStatus                @default(DRAFT)
  employmentType  EmploymentType           @map("employment_type")
  workplaceType   WorkplaceType            @map("workplace_type")
  location        String?                  @db.VarChar(255)
  salaryMin       Decimal?                 @map("salary_min") @db.Decimal(12, 2)
  salaryMax       Decimal?                 @map("salary_max") @db.Decimal(12, 2)
  salaryCurrency  String?                  @map("salary_currency") @db.VarChar(3)
  publishedAt     DateTime?                @map("published_at") @db.Timestamptz(3)
  closedAt        DateTime?                @map("closed_at") @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?                @map("deleted_at") @db.Timestamptz(3)
  searchVector    Unsupported("tsvector")? @map("search_vector")
  createdByUserId String                   @map("created_by_user_id") @db.Uuid

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("JobsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  skills       JobSkill[]
  savedBy      SavedJob[]
  views        JobView[]
  applications Application[]

  @@index([companyId, status, deletedAt])
  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([employmentType, workplaceType])
  @@map("jobs")
}

model JobSkill {
