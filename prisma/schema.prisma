  source    CandidateSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  // Active uniqueness handled by raw-SQL partial index saved_candidates_active_unique
  @@index([companyId, createdAt(sort: Desc), deletedAt])
  @@index([candidateUserId])
  @@index([savedByUserId])
  @@map("saved_candidates")
}

model TalentPool {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  name            String    @db.VarChar(255)
  description     String?   @db.Text
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  User                  @relation("TalentPoolsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  candidates TalentPoolCandidate[]

  // Name uniqueness on active rows handled by raw-SQL partial index talent_pools_name_active_unique
  @@index([companyId, createdAt(sort: Desc), deletedAt])
  @@index([createdByUserId])
  @@map("talent_pools")
}

model TalentPoolCandidate {
  id              String    @id @default(uuid()) @db.Uuid
  talentPoolId    String    @map("talent_pool_id") @db.Uuid
  candidateUserId String    @map("candidate_user_id") @db.Uuid
  addedByUserId   String    @map("added_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  talentPool TalentPool @relation(fields: [talentPoolId], references: [id], onDelete: Cascade)
  candidate  User       @relation("TalentPoolCandidates", fields: [candidateUserId], references: [id], onDelete: Cascade)
  addedBy    User       @relation("TalentPoolCandidatesAddedBy", fields: [addedByUserId], references: [id], onDelete: Restrict)

  // Active uniqueness handled by raw-SQL partial index talent_pool_candidates_active_unique
  @@index([talentPoolId, createdAt(sort: Desc), deletedAt])
  @@index([candidateUserId])
  @@map("talent_pool_candidates")
}

model CandidateNote {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  candidateUserId String    @map("candidate_user_id") @db.Uuid
  authorUserId    String    @map("author_user_id") @db.Uuid
  content         String    @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate User    @relation("CandidateNotesAsCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)
  author    User    @relation("CandidateNotesByAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([companyId, candidateUserId, createdAt(sort: Desc), deletedAt])
  @@index([authorUserId])
  @@map("candidate_notes")
}

model Interview {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId   String          @map("application_id") @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  scheduledAt     DateTime        @map("scheduled_at") @db.Timestamptz(3)
  durationMinutes Int             @default(60) @map("duration_minutes")
  location        String?         @db.Text
  meetingUrl      String?         @map("meeting_url") @db.Text
  notes           String?         @db.Text
  status          InterviewStatus @default(SCHEDULED)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  interviewers  Interviewer[]
  scorecards    Scorecard[]

  @@index([applicationId])
  @@index([companyId])
  @@index([scheduledAt])
  @@map("interviews")
}

model Interviewer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interviewId String   @map("interview_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  feedback    String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@map("interviewers")
}

model Scorecard {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interviewId       String         @map("interview_id") @db.Uuid
  applicationId     String         @map("application_id") @db.Uuid
  companyId         String         @map("company_id") @db.Uuid
  overallRating     Int            @map("overall_rating")
  recommendation    Recommendation
  notes             String         @db.Text
  submittedByUserId String         @map("submitted_by_user_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  interview    Interview          @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submittedBy  User               @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)
  sections     ScorecardSection[]

  @@unique([interviewId, submittedByUserId])
  @@index([applicationId])
  @@map("scorecards")
}

model ScorecardSection {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scorecardId String    @map("scorecard_id") @db.Uuid
  name        String    @db.VarChar(255)
  rating      Int
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  scorecard Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  @@map("scorecard_sections")
}

model Offer {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  companyId     String      @map("company_id") @db.Uuid
  position      String      @db.VarChar(255)
  salaryAmount  Decimal     @map("salary_amount") @db.Decimal(12, 2)
  currency      String      @default("USD") @db.VarChar(3)
  startDate     DateTime    @map("start_date") @db.Date
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(3)
  status        OfferStatus @default(DRAFT)
  notes         String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([companyId])
  @@map("offers")
}

// endregion

// region: Notifications and social graph

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  type        NotificationType
  // Free-form payload — keeps the table flexible across event types.
  payloadJson Json             @map("payload_json") @db.JsonB
  // Optional human-friendly fields populated by the producer for cheap renders.
  title       String?          @db.VarChar(255)
  body        String?          @db.Text
  actionUrl   String?          @map("action_url") @db.VarChar(2048)
  // Read tracking
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite index for "feed" reads (userId + DESC by createdAt + tie-break on id).
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  // Partial index notifications_unread_idx lives in raw SQL (Prisma can't express WHERE predicates).
  @@map("notifications")
}

model Connection {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @map("requester_id") @db.Uuid
  addresseeId String           @map("addressee_id") @db.Uuid
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  requester User @relation("ConnectionsAsRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ConnectionsAsAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId, status], name: "unique_active_connection")
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
  @@map("connections")
}

model Follow {
  id         String       @id @default(uuid()) @db.Uuid
  followerId String       @map("follower_id") @db.Uuid
  followeeId String       @map("followee_id") @db.Uuid
  status     FollowStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  follower User @relation("FollowsAsFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("FollowsAsFollowee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId], name: "unique_follow")
  @@index([followerId])
  @@index([followeeId])
  @@index([status])
  @@map("follows")
}

model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("BlocksAsBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksAsBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId], name: "unique_block")
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocks")
}

// endregion

// region: Posts and feed

model Post {
  id            String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId      String                     @map("author_id") @db.Uuid
  content       String                     @db.Text
  visibility    PostVisibility             @default(PUBLIC)
  status        PostStatus                 @default(PUBLISHED)
  contentStatus PostStatus?                @map("content_status")
  commentCount  Int                        @default(0) @map("comment_count")
  reactionCount Int                        @default(0) @map("reaction_count")
  shareCount    Int                        @default(0) @map("share_count")
  sharedPostId  String?                    @map("shared_post_id") @db.Uuid
  searchVector  Unsupported("tsvector")?   @default(dbgenerated("''::tsvector")) @map("search_vector")
  deletedAt     DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  author      User         @relation("PostsAsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  sharedPost  Post?        @relation("SharedPost", fields: [sharedPostId], references: [id])
  shares      Post[]       @relation("SharedPost")
  comments    Comment[]
  reactions   Reaction[]
  hashtags    PostHashtag[]
  media       PostMedia[]
  savedBy     SavedPost[]
  hiddenBy    HiddenPost[]
  mentions    Mention[]
  impressions PostImpression[]

  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)], name: "idx_posts_author_timeline")
  @@index([createdAt(sort: Desc), id(sort: Desc)], name: "idx_posts_feed")
  @@index([visibility, status, deletedAt])
  @@index([searchVector], type: Gin, name: "idx_posts_search")
  @@map("posts")
}

model Comment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  content       String    @db.Text
  contentStatus String?   @map("content_status") @db.VarChar(50)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User      @relation("CommentsAsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")
  mentions Mention[]

  @@index([postId, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

model Reaction {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String       @map("post_id") @db.Uuid
  authorId  String       @map("author_id") @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation("ReactionsAsAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([postId, authorId, type])
  @@index([postId])
  @@index([authorId])
  @@map("reactions")
}

model Hashtag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  postCount Int      @default(0) @map("post_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  posts          PostHashtag[]
  trendingEntries TrendingHashtag[]

  @@index([postCount(sort: Desc)])
  @@map("hashtags")
}

model TrendingHashtag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hashtagId   String   @map("hashtag_id") @db.Uuid
  score       Float
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  windowEnd   DateTime @map("window_end") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@index([score(sort: Desc)])
  @@index([windowEnd])
  @@map("trending_hashtags")
}

model PostHashtag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  hashtagId String   @map("hashtag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([postId, hashtagId])
  @@index([hashtagId])
  @@map("post_hashtags")
}

model PostMedia {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId       String   @map("post_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaAssetId])
  @@index([mediaAssetId])
  @@map("post_media")
}

model SavedPost {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_posts")
}

model HiddenPost {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@map("hidden_posts")
}

model Mention {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId          String?  @map("post_id") @db.Uuid
  commentId       String?  @map("comment_id") @db.Uuid
  mentionedUserId String   @map("mentioned_user_id") @db.Uuid
  mentionerUserId String   @map("mentioner_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post          Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment       Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User     @relation("MentionsAsMentioned", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  mentionerUser User     @relation("MentionsAsMentioner", fields: [mentionerUserId], references: [id], onDelete: Cascade)

  @@index([mentionedUserId])
  @@index([postId])
  @@index([commentId])
  @@map("mentions")
}

// endregion

// region: Messaging

model Conversation {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type               ConversationType @default(DIRECT)
  title              String?          @db.VarChar(255)
  lastMessageAt      DateTime?        @map("last_message_at") @db.Timestamptz(3)
  lastMessagePreview String?          @map("last_message_preview") @db.VarChar(500)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt(sort: Desc), id(sort: Desc)])
  @@map("conversations")
}

model ConversationParticipant {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String          @map("conversation_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  role           ParticipantRole @default(MEMBER)
  lastReadAt     DateTime?       @map("last_read_at") @db.Timestamptz(3)
  leftAt         DateTime?       @map("left_at") @db.Timestamptz(3)
  joinedAt       DateTime        @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@index([leftAt])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  content        String      @db.Text
  type           MessageType @default(TEXT)
  editedAt       DateTime?   @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]
  readStates   MessageReadState[]

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

// DEFERRED: MessageAttachment API is planned for Phase 7.1 (media attachments in messages).
// Schema model exists for migration forward-compatibility.
model MessageAttachment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message    Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([messageId, mediaAssetId])
  @@index([messageId])
  @@index([mediaAssetId])
  @@map("message_attachments")
}

// DEFERRED: MessageReadState API is planned for Phase 7.1 or Phase 8 (read receipts).
// Schema model exists for migration forward-compatibility.
model MessageReadState {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_read_states")
}

model ConversationSearchIndex {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String                 @map("conversation_id") @db.Uuid
  messageId      String                 @map("message_id") @db.Uuid
  textContent    Unsupported("tsvector")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([conversationId])
  @@index([textContent], type: Gin)
  @@map("conversation_search_index")
}

// endregion

// region: Search, moderation, admin, and analytics

// Phase 9 — Search: logs every user-facing search query for analytics and trending
model SearchQueryLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queryHash   String   @map("query_hash") // SHA-256 of sanitized search terms
  entityTypes String[] @map("entity_types") // e.g. ["profiles","jobs"]
  resultCount Int      @map("result_count")
  latencyMs   Int      @map("latency_ms")
  engine      String   // elasticsearch | postgres
  userId      String?  @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([queryHash])
  @@index([createdAt])
  @@index([engine])
  @@map("search_query_logs")
}

// Phase 9 — Search: tracks zero-downtime reindex operations (alias swap)
model SearchReindexRun {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType    String   @map("entity_type") // profiles | companies | jobs | posts
  oldIndex      String   @map("old_index")
  newIndex      String   @map("new_index")
  status        String   @default("in_progress") // in_progress | completed | failed
  documentCount Int      @default(0) @map("document_count")
  durationMs    Int      @default(0) @map("duration_ms")
  error         String?
  triggeredBy   String   @map("triggered_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(3)

  @@index([entityType])
  @@index([status])
  @@index([createdAt])
  @@map("search_reindex_runs")
}

model Report {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId   String            @map("reporter_id") @db.Uuid
  targetEntity ReportEntityType  @map("target_entity")
  targetId     String            @map("target_id") @db.Uuid
  category     ReportCategory
  description  String?           @db.Text
  status       ReportStatus      @default(PENDING)
  priority     Int               @default(1) @db.SmallInt
  assignedToId String?           @map("assigned_to_id") @db.Uuid
  resolvedAt   DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  reporter   User  @relation("ReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("ReportsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  actions    ModerationAction[]

  @@index([reporterId, targetEntity, targetId])
  @@index([targetEntity, targetId, createdAt(sort: Desc)])
  @@index([status, priority(sort: Desc), createdAt(sort: Desc)])
  @@index([assignedToId])
  @@map("reports")
}

model ModerationAction {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId         String                @map("report_id") @db.Uuid
  moderatorId      String                @map("moderator_id") @db.Uuid
  actionType       ModerationActionType  @map("action_type")
  targetEntity     ReportEntityType      @map("target_entity")
  targetId         String                @map("target_id") @db.Uuid
  reason           String                @db.Text
  durationHours    Int?                  @map("duration_hours")
  expiresAt        DateTime?             @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  moderator User @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Cascade)
  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([targetEntity, targetId])
  @@index([moderatorId])
  @@index([createdAt(sort: Desc)])
  @@map("moderation_actions")
}

model AdminUser {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  role      AdminRole
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions AdminPermission[]

  @@index([role])
  @@map("admin_users")
}

model AdminPermission {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String              @map("admin_user_id") @db.Uuid
  permission  AdminPermissionName
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, permission])
  @@map("admin_permissions")
}

model ProfileView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  source    String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User?   @relation("ProfileViewsByUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("profile_views")
}

model CompanyView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  source    String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation("CompanyViewsByUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("company_views")
}

model PostImpression {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  source    String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation("PostImpressionsByUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("post_impressions")
}

model SlottedCounter {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  slot       Int      @db.SmallInt
  count      BigInt   @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([entityType, entityId, slot])
  @@index([entityType, entityId])
  @@map("slotted_counters")
}

model AnalyticsDailyAggregate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date           DateTime @db.Date
  metricType     String   @map("metric_type") @db.VarChar(50)
  entityType     String?  @map("entity_type") @db.VarChar(50)
  entityId       String?  @map("entity_id") @db.Uuid
  count          BigInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([date, metricType, entityType, entityId])
  @@index([date, metricType])
  @@map("analytics_daily_aggregates")
}

// endregion
