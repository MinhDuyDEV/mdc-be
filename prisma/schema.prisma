// region: Prisma client and datasource

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// endregion

// region: Shared enums

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
  SUSPENDED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum MediaStatus {
  PENDING
  READY
  QUARANTINED
  DELETED
}

enum MediaVisibility {
  PRIVATE
  CONNECTIONS_ONLY
  PUBLIC
}

enum ProfileVisibility {
  PUBLIC
  CONNECTIONS_ONLY
  PRIVATE
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  TOOL
  SOFT
  OTHER
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LanguageProficiency {
  ELEMENTARY
  LIMITED_WORKING
  PROFESSIONAL_WORKING
  FULL_PROFESSIONAL
  NATIVE_BILINGUAL
}

enum Industry {
  TECHNOLOGY
  FINANCE
  HEALTHCARE
  EDUCATION
  RETAIL
  MANUFACTURING
  CONSULTING
  REAL_ESTATE
  HOSPITALITY
  TRANSPORTATION
  ENERGY
  TELECOMMUNICATIONS
  MEDIA
  LEGAL
  NONPROFIT
  GOVERNMENT
  AGRICULTURE
  CONSTRUCTION
  AUTOMOTIVE
  OTHER
}

enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
  BILLING_ADMIN
}

enum ApplyMode {
  INTERNAL
  EXTERNAL
  HYBRID
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  DELETED
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWED
  INTERVIEWING
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  REMOVED
}

enum FollowStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  // Applications domain
  ApplicationSubmitted
  ApplicationStatusChanged
  ApplicationNoteAdded
  ApplicationWithdrawn
  // Jobs domain
  JobPublished
  JobUpdated
  JobClosed
  // Recruiting domain
  CandidateSaved
  CandidateAddedToTalentPool
  RecruiterSeatAllocated
  // Connections domain
  ConnectionRequested
  ConnectionAccepted
  UserBlocked
  // System / generic
  System
  // Posts domain
  PostLiked
  PostCommented
  MentionedInPost
  MentionedInComment
  // Messaging domain
  NewMessage
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ParticipantRole {
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  SYSTEM
}

enum ReportEntityType {
  POST
  COMMENT
  MESSAGE
  PROFILE
  COMPANY
  JOB
}

enum ReportCategory {
  SPAM
  HARASSMENT
  HATE_SPEECH
  MISINFORMATION
  VIOLENCE
  IMPERSONATION
  COPYRIGHT
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED_ACTIONED
  RESOLVED_DISMISSED
}

enum ModerationActionType {
  WARN
  REMOVE_CONTENT
  SUSPEND_USER
  BAN_USER
  DISMISS
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

enum AdminPermissionName {
  MANAGE_USERS
  MANAGE_COMPANIES
  MANAGE_JOBS
  MODERATE_CONTENT
  VIEW_ANALYTICS
  MANAGE_ADMINS
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
  FLAGGED
  HIDDEN
  REMOVED_BY_MODERATOR
}

// region: Phase C enums

enum AlertFrequency {
  REALTIME
  DAILY
  WEEKLY
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum Recommendation {
  STRONG_HIRE
  HIRE
  NEUTRAL
  NO_HIRE
  STRONG_NO_HIRE
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

// endregion

enum PostVisibility {
  PUBLIC
  CONNECTIONS
  PRIVATE
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  LOVE
  INSIGHTFUL
  CURIOUS
}

// endregion

// region: Identity, auth, audit, outbox, and platform operations

model User {
  id                          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                       String                   @unique
  passwordHash                String?                  @map("password_hash")
  emailVerifiedAt             DateTime?                @map("email_verified_at")
  handle                      String?                  @unique
  displayName                 String?                  @map("display_name")
  status                      UserStatus               @default(ACTIVE)
  createdAt                   DateTime                 @default(now()) @map("created_at")
  updatedAt                   DateTime                 @updatedAt @map("updated_at")
  refreshTokens               RefreshToken[]
  auditLogs                   AuditLog[]
  verificationTokens          VerificationToken[]
  preference                  UserPreference?
  profile                     Profile?
  mediaAssets                 MediaAsset[]
  endorsements                Endorsement[]
  companyMembers              CompanyMember[]
  companyFollowers            CompanyFollower[]
  verificationsRequested      CompanyVerification[]    @relation("VerificationRequester")
  verificationsReviewed       CompanyVerification[]    @relation("VerificationReviewer")
  recruiterSeats              RecruiterSeat[]
  memberInvitations           MemberInvitation[]
  jobsCreated                 Job[]                    @relation("JobsCreated")
  savedJobs                   SavedJob[]
  jobViews                    JobView[]
  applications                Application[]
  applicationStatusEvents     ApplicationStatusEvent[] @relation("ApplicationStatusEvents")
  applicationNotes            ApplicationNote[]        @relation("ApplicationNotes")
  savedCandidatesAsCandidate  SavedCandidate[]         @relation("SavedCandidatesAsCandidate")
  savedCandidatesBySaver      SavedCandidate[]         @relation("SavedCandidatesBySaver")
  talentPoolsCreated          TalentPool[]             @relation("TalentPoolsCreated")
  talentPoolCandidates        TalentPoolCandidate[]    @relation("TalentPoolCandidates")
  talentPoolCandidatesAddedBy TalentPoolCandidate[]    @relation("TalentPoolCandidatesAddedBy")
  candidateNotesAsCandidate   CandidateNote[]          @relation("CandidateNotesAsCandidate")
  candidateNotesByAuthor      CandidateNote[]          @relation("CandidateNotesByAuthor")
  notifications               Notification[]
  connectionsAsRequester      Connection[]             @relation("ConnectionsAsRequester")
  connectionsAsAddressee      Connection[]             @relation("ConnectionsAsAddressee")
  followsAsFollower           Follow[]                @relation("FollowsAsFollower")
  followsAsFollowee           Follow[]                @relation("FollowsAsFollowee")
  blocksAsBlocker   Block[]    @relation("BlocksAsBlocker")
  blocksAsBlocked   Block[]    @relation("BlocksAsBlocked")
  posts              Post[]    @relation("PostsAsAuthor")
  comments           Comment[] @relation("CommentsAsAuthor")
  reactions          Reaction[] @relation("ReactionsAsAuthor")
  savedPosts         SavedPost[]
  hiddenPosts        HiddenPost[]
  mentionsReceived   Mention[] @relation("MentionsAsMentioned")
  mentionsGiven      Mention[] @relation("MentionsAsMentioner")
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]                 @relation("MessagesSent")
  messageReadStates        MessageReadState[]
  notificationPreference   NotificationPreference?
  realtimeDeliveryReceipts RealtimeDeliveryReceipt[]
  devices                  UserDevice[]
  recommendationFeedback   RecommendationFeedback[]  @relation("RecommendationFeedback")
  recommendationDismissals RecommendationDismissal[] @relation("RecommendationDismissal")
  reportsCreated           Report[]                  @relation("ReportsCreated")
  reportsAssigned          Report[]                  @relation("ReportsAssigned")
  moderatorActions         ModerationAction[]        @relation("ModeratorActions")
  adminUser                AdminUser?
  profileViewsByUser       ProfileView[]             @relation("ProfileViewsByUser")
  companyViewsByUser       CompanyView[]             @relation("CompanyViewsByUser")
  postImpressionsByUser    PostImpression[]          @relation("PostImpressionsByUser")
  savedSearches            SavedSearch[]
  interviews               Interviewer[]
  submittedScorecards      Scorecard[]

  @@map("users")
}

model RefreshToken {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  tokenHash     String         @unique @map("token_hash")
  familyId      String         @map("family_id") @db.Uuid
  parentTokenId String?        @map("parent_token_id") @db.Uuid
  expiresAt     DateTime       @map("expires_at")
  revokedAt     DateTime?      @map("revoked_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentToken   RefreshToken?  @relation("RefreshTokenFamilyTree", fields: [parentTokenId], references: [id], onDelete: SetNull)
  childTokens   RefreshToken[] @relation("RefreshTokenFamilyTree")

  @@index([userId])
  @@index([familyId])
  @@index([parentTokenId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventType     String            @map("event_type")
  aggregateType String?           @map("aggregate_type")
  aggregateId   String?           @map("aggregate_id")
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now()) @map("available_at")
  lockedAt      DateTime?         @map("locked_at")
  lockedBy      String?           @map("locked_by")
  processedAt   DateTime?         @map("processed_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deadLetter    OutboxDeadLetter?

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType])
  @@map("outbox_events")
}

model OutboxDeadLetter {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outboxEventId String?      @unique @map("outbox_event_id") @db.Uuid
  eventType     String       @map("event_type")
  payload       Json
  reason        String
  failedAt      DateTime     @default(now()) @map("failed_at")
  outboxEvent   OutboxEvent? @relation(fields: [outboxEventId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([failedAt])
  @@map("outbox_dead_letters")
}

model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope          String
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model VerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model UserPreference {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  theme     String?  @default("system")
  language  String?  @default("en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model NotificationPreference {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid

  // Notification type toggles
  newMessage              Boolean @default(true) @map("new_message")
  connectionRequest       Boolean @default(true) @map("connection_request")
  connectionAccepted      Boolean @default(true) @map("connection_accepted")
  applicationStatusChange Boolean @default(true) @map("application_status_change")
  jobRecommendation       Boolean @default(true) @map("job_recommendation")
  postInteraction         Boolean @default(true) @map("post_interaction")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model RecommendationFeedback {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  entityType String   @db.VarChar(50) // 'person', 'job', 'company'
  entityId   String   @db.Uuid
  feedback   String   @db.VarChar(20) // 'helpful', 'not_helpful', 'irrelevant'
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation("RecommendationFeedback", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId], name: "unique_recommendation_feedback")
  @@index([userId])
  @@index([entityType, entityId])
  @@map("recommendation_feedback")
}

model RecommendationDismissal {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  entityType String   @db.VarChar(50) // 'person', 'job', 'company'
  entityId   String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation("RecommendationDismissal", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId], name: "unique_recommendation_dismissal")
  @@index([userId])
  @@index([entityType, entityId])
  @@map("recommendation_dismissals")
}

model RealtimeDeliveryReceipt {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  eventType      String    @map("event_type")
  eventId        String    @map("event_id") @db.Uuid
  deliveredAt    DateTime  @default(now()) @map("delivered_at")
  acknowledgedAt DateTime? @map("acknowledged_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventType])
  @@index([eventId])
  @@map("realtime_delivery_receipts")
}

model UserDevice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  deviceType  String    @map("device_type") // ios, android, web
  deviceToken String?   @map("device_token") // FCM/APNs token (future)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}

model EmailDelivery {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  to           String
  subject      String
  template     String
  context      Json
  status       EmailStatus @default(PENDING)
  attempts     Int         @default(0)
  sentAt       DateTime?   @map("sent_at")
  failedAt     DateTime?   @map("failed_at")
  errorMessage String?     @map("error_message")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("email_deliveries")
}

// endregion

// region: Profiles, companies, media, and billing

model Profile {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String                   @unique @map("user_id") @db.Uuid
  headline           String?                  @db.VarChar(200)
  about              String?                  @db.Text
  location           String?                  @db.VarChar(200)
  website            String?                  @db.VarChar(500)
  openToWork         Boolean                  @default(false) @map("open_to_work")
  recruitingEligible Boolean                  @default(false) @map("recruiting_eligible")
  visibility         ProfileVisibility        @default(PUBLIC)
  searchVector       Unsupported("tsvector")? @default(dbgenerated("''::tsvector")) @map("search_vector")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?                @map("deleted_at") @db.Timestamptz(3)

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills         ProfileSkill[]
  experiences    Experience[]
  educations     Education[]
  certifications Certification[]
  languages      ProfileLanguage[]
  endorsements   Endorsement[]
  views          ProfileView[]

  @@index([searchVector], type: Gin, name: "idx_profiles_search")
  @@index([deletedAt])
  @@map("profiles")
}

model Company {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String                   @db.VarChar(200)
  slug              String                   @db.VarChar(200)
  industry          Industry?
  description       String?                  @db.Text
  website           String?                  @db.VarChar(500)
    logoMediaAssetId  String?                  @map("logo_media_asset_id") @db.Uuid
    coverMediaAssetId String?                  @map("cover_media_asset_id") @db.Uuid
    verified          Boolean                  @default(false)
    verifiedAt        DateTime?                @map("verified_at") @db.Timestamptz(3)
    employeeCount     String?                  @map("employee_count") @db.VarChar(50)
    foundedYear       Int?                     @map("founded_year")
    headquarters      String?                  @db.VarChar(200)
  searchVector      Unsupported("tsvector")? @default(dbgenerated("''::tsvector")) @map("search_vector")
  deletedAt         DateTime?                @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  logoMediaAsset    MediaAsset?           @relation("CompanyLogo", fields: [logoMediaAssetId], references: [id], onDelete: SetNull)
  coverMediaAsset   MediaAsset?           @relation("CompanyCover", fields: [coverMediaAssetId], references: [id], onDelete: SetNull)
  members           CompanyMember[]
  followers         CompanyFollower[]
  verifications     CompanyVerification[]
  entitlements      CompanyEntitlement[]
  recruiterSeats    RecruiterSeat[]
  memberInvitations MemberInvitation[]
  jobs              Job[]
  savedCandidates   SavedCandidate[]
  talentPools       TalentPool[]
  candidateNotes    CandidateNote[]
  views             CompanyView[]
  subscription      Subscription?
  entitlementGrants EntitlementGrant[]
  creditTransactions CreditTransaction[]
  invoices          Invoice[]
  interviews        Interview[]
  scorecards        Scorecard[]
  offers            Offer[]

  @@index([slug])
  @@index([industry])
  @@index([verified])
  @@index([deletedAt])
  @@index([searchVector], type: Gin, name: "idx_companies_search")
  @@map("companies")
}

model Skill {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String        @unique @db.VarChar(100)
  category  SkillCategory?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  profileSkills ProfileSkill[]
  jobSkills     JobSkill[]

  @@map("skills")
}

model ProfileSkill {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String            @map("profile_id") @db.Uuid
  skillId     String            @map("skill_id") @db.Uuid
  name        String            @db.VarChar(100)
  category    SkillCategory?
  proficiency SkillProficiency?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill        Skill         @relation(fields: [skillId], references: [id])
  endorsements Endorsement[]

  @@unique([profileId, skillId])
  @@index([skillId])
  @@map("profile_skills")
}

model Experience {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  title       String    @db.VarChar(200)
  company     String    @db.VarChar(200)
  companyUrl  String?   @map("company_url") @db.VarChar(500)
  location    String?   @db.VarChar(200)
  description String?   @db.Text
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isCurrent   Boolean   @default(false) @map("is_current")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("experiences")
}

model Education {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId    String    @map("profile_id") @db.Uuid
  school       String    @db.VarChar(200)
  degree       String    @db.VarChar(200)
  fieldOfStudy String?   @map("field_of_study") @db.VarChar(200)
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  grade        String?   @db.VarChar(50)
  activities   String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("educations")
}

model Certification {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId           String    @map("profile_id") @db.Uuid
  name                String    @db.VarChar(200)
  issuingOrganization String    @map("issuing_organization") @db.VarChar(200)
  issueDate           DateTime  @map("issue_date") @db.Date
  expirationDate      DateTime? @map("expiration_date") @db.Date
  credentialId        String?   @map("credential_id") @db.VarChar(200)
  credentialUrl       String?   @map("credential_url") @db.VarChar(500)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("certifications")
}

model ProfileLanguage {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String              @map("profile_id") @db.Uuid
  language    String              @db.VarChar(100)
  proficiency LanguageProficiency
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, language])
  @@map("profile_languages")
}

model Endorsement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId      String   @map("profile_id") @db.Uuid
  profileSkillId String   @map("profile_skill_id") @db.Uuid
  endorserId     String   @map("endorser_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileSkill ProfileSkill @relation(fields: [profileSkillId], references: [id], onDelete: Cascade)
