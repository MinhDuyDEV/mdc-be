model Application {
  id                 String            @id @default(uuid()) @db.Uuid
  jobId              String            @map("job_id") @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  status             ApplicationStatus @default(SUBMITTED)
  coverLetter        String?           @map("cover_letter") @db.Text
  resumeMediaAssetId String?           @map("resume_media_asset_id") @db.Uuid
  idempotencyKey     String?           @map("idempotency_key") @db.VarChar(255)
  submittedAt        DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  withdrawnAt        DateTime?         @map("withdrawn_at") @db.Timestamptz(3)

  job              Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeMediaAsset MediaAsset? @relation("ApplicationResume", fields: [resumeMediaAssetId], references: [id], onDelete: SetNull)

  answers      ApplicationAnswer[]
  attachments  ApplicationAttachment[]
  statusEvents ApplicationStatusEvent[]
  notes        ApplicationNote[]

  @@index([jobId, status, submittedAt(sort: Desc)])
  @@index([userId, submittedAt(sort: Desc)])
  @@map("applications")
}

model ApplicationAnswer {
