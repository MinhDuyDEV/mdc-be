{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["src/main.ts", "src/app.module.ts", "src/instrumentation.ts"],
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "node_modules/**",
    ".opencode/**",
    "test/**",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.d.ts"
  ],
  "ignoreDependencies": [
    "@nestjs/passport",
    "@nestjs/decorators",
    "cookie-parser",
    "passport",
    "passport-jwt",
    "@nestjs/schematics",
    "@nestjs/mapped-types",
    "supertest",
    "testcontainers",
    "@testcontainers/postgresql",
    "socket.io-client",
    "@socket.io/redis-adapter",
    "eslint-config-prettier",
    "eslint-plugin-prettier",
    "@eslint/eslintrc",
    "pino-pretty",
    "tsconfig-paths",
    "source-map-support"
  ],
  "duplicates": {
    "minOccurrences": 3,
    "ignore": ["**/test/**", "**/*.spec.ts"]
  },
  "rules": {
    "unused-dependencies": "warn"
  }
}
